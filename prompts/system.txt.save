const fs = require("fs");
const path = require("path");

const axios = require("axios");

const pty = require("node-pty");

//
// DANGEROUS COMMANDS
//
const BLOCKED_COMMANDS = [
  "rm -rf /",
  "shutdown",
  "reboot",
  "mkfs",
  ":(){ :|:& };:",
];

//
// PERSISTENT SHELL SESSIONS
//
const sessions = {};

function getSession(sessionId = "default") {

  if (!sessions[sessionId]) {

    sessions[sessionId] = pty.spawn(
      "/bin/bash",
      [],
      {
        name: "xterm-color",
        cols: 120,
        rows: 40,
        cwd: process.cwd(),
        env: process.env,
      }
    );
  }

  return sessions[sessionId];
}

//
// SHELL
//
async function runShell(
  command,
  sessionId = "default"
) {

  if (
    BLOCKED_COMMANDS.some(x =>
      command.includes(x)
    )
  ) {

    return {
      success: false,
      error: "Blocked dangerous command",
    };
  }

  return new Promise((resolve) => {

    const shell =
      getSession(sessionId);

    let output = "";

    const onData = (data) => {
      output += data;
    };

    shell.onData(onData);

    shell.write(command + "\n");

    setTimeout(() => {

      resolve({
        success: true,
        output,
      });

    }, 2000);
  });
}

//
// READ FILE
//
function readFile(filePath) {

  try {

    const content =
      fs.readFileSync(filePath, "utf8");

    return {
      success: true,
      content,
    };

  } catch (err) {

    return {
      success: false,
      error: err.message,
    };
  }
}

//
// WRITE FILE
//
function writeFile(
  filePath,
  content
) {

  try {

    const dir =
      path.dirname(filePath);

    fs.mkdirSync(dir, {
      recursive: true,
    });

    fs.writeFileSync(
      filePath,
      content
    );

    return {
      success: true,
    };

  } catch (err) {

    return {
      success: false,
      error: err.message,
    };
  }
}

//
// REPLACE IN FILE
//
function replaceInFile(
  filePath,
  oldText,
  newText
) {

  try {

    const content =
      fs.readFileSync(
        filePath,
        "utf8"
      );

    const updated =
      content.replace(
        oldText,
        newText
      );

    fs.writeFileSync(
      filePath,
      updated
    );

    return {
      success: true,
    };

  } catch (err) {

    return {
      success: false,
      error: err.message,
    };
  }
}

//
// LIST DIRECTORY
//
function listDir(dirPath = ".") {

  try {

    const files =
      fs.readdirSync(dirPath);

    return {
      success: true,
      files,
    };

  } catch (err) {

    return {
      success: false,
      error: err.message,
    };
  }
}

//
// WEB SEARCH
//
async function webSearch(query) {

  try {

    if (!process.env.TAVILY_API_KEY) {

      return {
        success: false,
        error: "Missing TAVILY_API_KEY",
      };
    }

    const response =
      await axios.post(
        "https://api.tavily.com/search",
        {
          api_key:
            process.env.TAVILY_API_KEY,

          query,

          search_depth: "advanced",

          include_answer: true,

          max_results: 5,
        }
      );

    return {
      success: true,
      results: response.data,
    };

  } catch (err) {

    return {
      success: false,
      error: err.message,
    };
  }
}

module.exports = {
  runShell,
  readFile,
  writeFile,
  replaceInFile,
  listDir,
  webSearch,
};
